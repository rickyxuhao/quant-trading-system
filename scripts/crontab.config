# Stock Trading Project - 数据同步定时任务配置
# 
# 使用说明:
# 1. 复制以下内容到你的 crontab: crontab -e
# 2. 或者保存为文件后导入: crontab /path/to/this/file
# 3. 查看当前 crontab: crontab -l
# 4. 查看执行日志: tail -f /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/sync_$(date +%Y%m%d).log

# 环境变量设置（重要！）
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# 股票基础信息 - 每天早上9点全量同步
0 9 * * * /Users/xuhaoricky/ClawProject/Stock-trading-project/scripts/run_sync.sh stock_basic >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/cron_$(date +\%Y\%m\%d).log 2>&1

# 交易日历 - 每年1月1号全量同步
0 9 1 1 * /Users/xuhaoricky/ClawProject/Stock-trading-project/scripts/run_sync.sh trade_date >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/cron_$(date +\%Y\%m\%d).log 2>&1

# 股票日线行情 - 每天16:00增量同步
0 16 * * * /Users/xuhaoricky/ClawProject/Stock-trading-project/scripts/run_sync.sh stock_daily_market_data >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/cron_$(date +\%Y\%m\%d).log 2>&1

# ST股票列表 - 每天16:30增量同步（依赖日线行情）
30 16 * * * /Users/xuhaoricky/ClawProject/Stock-trading-project/scripts/run_sync.sh stock_st_list >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/cron_$(date +\%Y\%m\%d).log 2>&1

# 日线数据（待实现）- 收盘后15:30同步
# 30 15 * * * /Users/xuhaoricky/ClawProject/Stock-trading-project/scripts/run_sync.sh daily_price >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/cron_$(date +\%Y\%m\%d).log 2>&1

# 持仓分析系统 - 收盘后同步（17:00执行，确保行情数据已同步）
0 17 * * * cd /Users/xuhaoricky/ClawProject/Stock-trading-project && /Library/Frameworks/Python.framework/Versions/3.11/bin/python projects/portfolio_analysis/sync/daily_sync.py >> /Users/xuhaoricky/ClawProject/Stock-trading-project/logs/portfolio_sync_$(date +\%Y\%m\%d).log 2>&1
