# Tushare API Token
# 从 https://tushare.pro 注册获取
TUSHARE_TOKEN=your_tushare_token_here

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_CHARSET=utf8mb4

# 数据库名称
DB_NAME_TUSHARE=tushare_biz
DB_NAME_INTERFACE=interface

# 可选：连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
