  "workflows": {
    "factor_discovery": {
      "name": "因子发现流程",
      "steps": [
        {"agent": "fund-manager-001", "task": "assign_factor_research", "output": "research_brief"},
        {"agent": "data-engineer-001", "task": "prepare_data", "input": "research_brief", "output": "data_ready"},
        {"agent": "factor-seeker-001", "task": "discover_factors", "input": "data_ready", "output": "factor_candidates"},
        {"agent": "backtest-engineer-001", "task": "validate_ic", "input": "factor_candidates", "output": "ic_results"},
        {"agent": "backtest-engineer-001", "task": "layered_backtest", "input": "ic_results", "output": "layered_results"}
      ],
      "exitCondition": "icir > 0.5 AND monotonicity > 0.7",
      "onFailure": "trigger_factor_rediscovery"
    },
    "strategy_development": {
      "name": "策略开发流程",
      "steps": [
        {"agent": "fund-manager-001", "task": "assign_strategy_development", "output": "strategy_brief"},
        {"agent": "factor-seeker-001", "task": "deliver_validated_factors", "input": "strategy_brief", "output": "factor_pool"},
        {"agent": "strategy-researcher-001", "task": "generate_signals", "input": "factor_pool", "output": "raw_signals"},
        {"agent": "risk-manager-001", "task": "risk_review", "input": "raw_signals", "output": "risk_approved_signals"},
        {"agent": "backtest-engineer-001", "task": "full_backtest", "input": "risk_approved_signals", "output": "backtest_report"},
        {"agent": "risk-manager-001", "task": "final_approval", "input": "backtest_report", "output": "go_no_go_decision"}
      ],
      "exitCondition": "sharpe > 1.0 AND max_drawdown < 0.20",
      "onFailure": "trigger_strategy_iteration"
    },
    "code_development": {
      "name": "代码开发流程",
      "steps": [
        {"agent": "requester", "task": "submit_prd", "output": "feature_request"},
        {"agent": "architect-001", "task": "design_solution", "input": "feature_request", "output": "rfc_document"},
        {"agent": "code-maintainer-001", "task": "implement", "input": "rfc_document", "output": "code_with_tests"},
        {"agent": "code-maintainer-001", "task": "verify_tests", "input": "code_with_tests", "output": "test_results"},
        {"agent": "architect-001", "task": "code_review", "input": "code_with_tests", "output": "review_approval"},
        {"agent": "fund-manager-001", "task": "deliver_to_requester", "input": "review_approval", "output": "completed_feature"}
      ],
      "exitCondition": "tests_passed AND review_approved",
      "onFailure": "return_to_implement"
    },
    "daily_production": {
      "name": "每日生产流程",
      "steps": [
        {"agent": "data-engineer-001", "task": "daily_sync", "output": "data_updated"},
        {"agent": "strategy-researcher-001", "task": "generate_signals", "input": "data_updated", "output": "today_signals"},
        {"agent": "risk-manager-001", "task": "risk_check", "input": "today_signals", "output": "approved_signals"},
        {"agent": "backtest-engineer-001", "task": "monitor_decay", "input": "approved_signals", "output": "decay_report"}
      ],
      "schedule": "daily_16:30",
      "exitCondition": "signals_generated",
      "onAnomaly": "trigger_investigation"
    }
  },
  "feedbackTriggers": {
    "factor_decay": {
      "triggerId": "factor-decay-001",
      "name": "因子衰减检测",
      "condition": "forward_5d_ic < 0.02 OR icir_20d < 0.3",
      "sourceAgent": "backtest-engineer-001",
      "targetAgent": "factor-seeker-001",
      "action": "trigger_rediscovery",
      "priority": "high",
      "message": "因子衰减严重，需重新挖掘替代因子"
    },
    "regime_shift": {
      "triggerId": "regime-shift-001", 
      "name": "市场环境变化",
      "condition": "rolling_sharpe_60d < 0.5 AND sharpe_decline_20d > 30%",
      "sourceAgent": "backtest-engineer-001",
      "targetAgent": "strategy-researcher-001",
      "action": "trigger_recalibration",
      "priority": "critical",
      "message": "市场环境变化，策略需重新校准权重"
    },
    "lookahead_detected": {
      "triggerId": "lookahead-001",
      "name": "前瞻偏差检测",
      "condition": "bootstrap_p_value > 0.05 AND historical_sharpe > 2.0",
      "sourceAgent": "backtest-engineer-001",
      "targetAgent": "fund-manager-001",
      "action": "halt_and_alert",
      "priority": "critical",
      "message": "疑似前瞻偏差，立即停止研究并审查"
    },
    "drawdown_breach": {
      "triggerId": "drawdown-001",
      "name": "回撤超限",
      "condition": "current_drawdown > 0.15",
      "sourceAgent": "risk-manager-001",
      "targetAgent": "strategy-researcher-001",
      "action": "reduce_position",
      "priority": "high",
      "message": "回撤超过15%，建议减仓或暂停策略"
    },
    "data_quality_issue": {
      "triggerId": "data-quality-001",
      "name": "数据质量异常",
      "condition": "missing_data_ratio > 0.05 OR outlier_count > 100",
      "sourceAgent": "data-engineer-001",
      "targetAgent": "fund-manager-001",
      "action": "pause_pipeline",
      "priority": "critical",
      "message": "数据质量异常，暂停生产流程"
    }
  },
  "version": "3.0.0",
  "updatedAt": "2026-03-21T10:15:00.000Z"
